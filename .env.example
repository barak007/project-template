NODE_ENV=development
PORT=3000
BACKOFFICE_PORT=5173
POSTGRES_PORT=5432
DATABASE_URL=postgres://postgres:postgres@localhost:5432/app
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
TRUSTED_ORIGINS=http://localhost:3000,http://localhost:5173
SECRETS_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
# Backoffice admin credential — leave both empty and the backoffice shows a
# first-run setup screen that fills them in (the password is stored hashed).
BACKOFFICE_ADMIN_EMAIL=
BACKOFFICE_ADMIN_PASSWORD_HASH=
LOG_LEVEL=info
SENTRY_DSN=
SHUTDOWN_TIMEOUT_MS=10000
